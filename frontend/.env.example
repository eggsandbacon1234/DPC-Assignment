# Copy this file to .env and adjust.

# Base URL of the Express backend.
# - Local dev: leave empty, Vite proxies /api to http://localhost:5000
# - Production: the EC2 backend, e.g. http://ec2-xx-xx-xx-xx.ap-southeast-1.compute.amazonaws.com:5000
VITE_API_URL=

# true  = run the whole UI with a fake in-browser backend (no server needed).
#         Good for working on the UI before the backend is ready, or for demo backup.
# false = talk to the real Express backend.
VITE_USE_MOCK=true
